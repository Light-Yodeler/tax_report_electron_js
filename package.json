{
  "name": "laporan-pajak-bapenda",
  "version": "1.0.0",
  "description": "Aplikasi Rekapitulasi Pendapatan & Pelaporan Pajak Daerah Bapenda untuk Anda Bungalows & Restaurant",
  "main": "electron/main.js",
  "scripts": {
    "dev:react": "vite",
    "build:react": "vite build",
    "dev:electron": "electron .",
    "dev": "concurrently -k \"npm run dev:react\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build && electron-builder",
    "build:mac": "vite build && electron-builder --mac",
    "build:win": "vite build && electron-builder --win",
    "build:all": "vite build && electron-builder -mw"
  },
  "build": {
    "appId": "com.andabungalows.laporanbapenda",
    "productName": "Laporan Bapenda Anda",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.business",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "keywords": [
    "electron",
    "react",
    "vite",
    "bapenda",
    "tax-report"
  ],
  "author": "Anda Bungalows & Restaurant",
  "license": "ISC",
  "dependencies": {
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.1",
    "sql.js": "^1.12.0",
    "tailwind-merge": "^3.0.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "electron": "^34.3.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "vite": "^6.2.0",
    "wait-on": "^8.0.2"
  }
}